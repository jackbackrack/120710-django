DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ENV=local
TIMESCALE_IMAGE=timescale/timescaledb-ha:pg15-ts2.26.4
POSTGRES_DB=eatart
POSTGRES_USER=eatart
POSTGRES_PASSWORD=eatart
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eatart:eatart@localhost:5432/eatart
POSTGRES_DUMP_FILE=source/120710-database
USE_S3=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
# Optional override; defaults to True only when both keys are set.
RECAPTCHA_ENABLED=

# ── Mailing list ─────────────────────────────────────────────────────────────
# Resend sends campaigns only; transactional mail stays on its own provider.
# See docs/mailing-list.md.
RESEND_API_KEY=
# Signs the bounce/complaint webhook at /anymail/resend/tracking/. Without it the
# webhook rejects everything and nobody is ever suppressed.
RESEND_SIGNING_SECRET=

# Absolute base for links in campaign mail. Campaign sends run in a background thread
# with no request to build URLs from, so this is where the unsubscribe link's host
# comes from. Getting it wrong breaks unsubscribe in mail already sent.
SITE_BASE_URL=http://localhost:8000

# Optional. One API request per message, so this is the provider's rate limit —
# Resend allows about two a second by default.
CAMPAIGN_MESSAGES_PER_SECOND=2
# Optional. False sends inline rather than in a background thread; useful locally when
# you want the traceback instead of a log line.
CAMPAIGN_SEND_IN_BACKGROUND=
# Leave false until reset.art has its own DKIM and SPF. Subscribers can be collected
# onto the network-wide list meanwhile, just not mailed.
CAMPAIGN_NETWORK_LIST_ENABLED=false
